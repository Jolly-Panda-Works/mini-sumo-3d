# The server's settings. On the server: copy this file to .env (next to docker-compose.yml)
# once, then only edit values in it. Deploying is always just:
#
#   git pull
#   docker compose up -d --build
#
# Nothing else is run on the server: the image builds everything, and the game checks its
# keys at startup (see "docker compose logs web"). Empty values turn that feature off.
# Keep .env private: it holds keys (it is never committed).

# ---------------------------------------------------------------- the game
# Port the game is served on (put your HTTPS proxy in front of it).
WEB_PORT=6803
# The game's public address (links in emails, Sign in with Bazaar's return address).
PUBLIC_URL=https://sumo.ryujin.fans/
# Apps older than this version must update before they can play (e.g. 1.24.0).
# Empty: players are only told that an update is available.
CLIENT_MIN_VERSION=
# false: no economy event lines in the log.
ECONOMY_EVENT_LOG=true

# ---------------------------------------------------------------- Cafe Bazaar
# Coin purchases from the Bazaar app are checked with Cafe Bazaar before coins are given.
# Bazaar panel -> the app -> "API پیشخان بازار" -> "دریافت توکن جدید". The same token as the
# BAZAAR_PISHKHAN_TOKEN secret on GitHub (a new token replaces the old one: update both).
BAZAAR_PISHKHAN_TOKEN=
BAZAAR_PACKAGE_NAME=com.jollypanda.mini_sumo

# Sign in with Cafe Bazaar in the web game. Bazaar panel -> the app -> "ورود با بازار":
# the client id and secret; there, allow the return address <PUBLIC_URL>api/account/bazaar/callback
BAZAAR_LOGIN_CLIENT_ID=
BAZAAR_LOGIN_SECRET=
# Other addresses the web game runs on, comma-separated (this server's and GitHub Pages are
# always allowed).
BAZAAR_LOGIN_RETURN_ORIGINS=

# ---------------------------------------------------------------- saving progress with an email
# EmailJS (see docs/EMAIL.fa.md).
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAIL_REPLY_TO=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# ---------------------------------------------------------------- building the image
# Docker Hub mirror for the base images (Docker Hub refuses Iranian IPs).
# Others to try if one is down: focker.ir, docker.iranserver.com, hub.hamdocker.ir
# Outside Iran: docker.io
REGISTRY=docker.arvancloud.ir
# npm registry (or a mirror if registry.npmjs.org is slow / blocked).
NPM_REGISTRY=https://registry.npmjs.org/
# Optional proxy used only while building (npm downloads).
# HTTP_PROXY=http://127.0.0.1:10809
# HTTPS_PROXY=http://127.0.0.1:10809
# NO_PROXY=localhost,127.0.0.1
# Where the web game finds the server. "same-origin" = this same container (default).
# VITE_SERVER_URL=same-origin
# Version shown in Settings (defaults to package.json).
# VITE_APP_VERSION=

# ---------------------------------------------------------------- older Bazaar purchase keys
# Only if you already use an OAuth client for purchase checks; BAZAAR_PISHKHAN_TOKEN replaces it.
# BAZAAR_CLIENT_ID=
# BAZAAR_CLIENT_SECRET=
# BAZAAR_REFRESH_TOKEN=
