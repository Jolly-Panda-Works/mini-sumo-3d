{
  "name": "@mini-sumo/desktop",
  "productName": "Mini Sumo",
  "version": "0.1.0",
  "private": true,
  "description": "Mini Sumo desktop app (Electron shell around the web client).",
  "author": {
    "name": "Mini Sumo",
    "email": "dev@mini-sumo.local"
  },
  "homepage": "https://github.com/Jolly-Panda-Works/mini-sumo-3d",
  "main": "main.cjs",
  "scripts": {
    "prepare:web": "node scripts/copy-web.mjs",
    "start": "npm run prepare:web && electron .",
    "dist": "npm run prepare:web && node scripts/package.mjs",
    "dist:win": "npm run prepare:web && node scripts/package.mjs --win",
    "dist:mac": "npm run prepare:web && node scripts/package.mjs --mac",
    "dist:linux": "npm run prepare:web && node scripts/package.mjs --linux"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "io.minisumo.desktop",
    "productName": "Mini Sumo",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "MiniSumo-${version}-Windows-Setup.${ext}"
    },
    "portable": {
      "artifactName": "MiniSumo-${version}-Windows-Portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "identity": null,
      "artifactName": "MiniSumo-${version}-macOS-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "maintainer": "Mini Sumo <dev@mini-sumo.local>",
      "artifactName": "MiniSumo-${version}-Linux-${arch}.${ext}",
      "executableName": "mini-sumo"
    }
  },
  "repository": "https://github.com/Jolly-Panda-Works/mini-sumo-3d",
  "license": "UNLICENSED"
}
