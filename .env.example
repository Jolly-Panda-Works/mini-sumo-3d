# ---- Server (apps/server) ----
# Port the Colyseus/HTTP server listens on.
PORT=2567
# Interface to bind. 0.0.0.0 allows other devices on your LAN (e.g. a phone) to connect.
HOST=0.0.0.0

# ---- Client (apps/client, read by Vite at build time) ----
# Public WebSocket endpoint of the Colyseus server.
# Leave empty in local development: the client then uses ws://<page-hostname>:2567.
# In production set it to your server, e.g. wss://sumo-server.example.com
VITE_SERVER_URL=
# online | offline | auto (default). auto: production builds without VITE_SERVER_URL run
# offline; otherwise the server's /health is checked and the game goes offline if it's down.
# Offline = every room runs on the device against bots.
VITE_NETWORK_MODE=auto
# Port used for the automatic fallback URL above (only when VITE_SERVER_URL is empty).
VITE_SERVER_PORT=2567
# Public address of the web build, used for invite links from desktop/Android apps.
# e.g. https://<user>.github.io/<repo>/
VITE_PUBLIC_URL=
# Base path of the web build. "/" normally; "/<repo>/" on GitHub Pages (CI sets this).
VITE_BASE=/
